# Meta WhatsApp Business — Cloud API
# Dashboard: https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-dev-console/
META_VERIFY_TOKEN=                # string aleatória que você escolhe; usada no GET de verificação do webhook
META_APP_SECRET=                  # secret da App (configurações → básico) — usado pra validar HMAC do POST
META_WA_TOKEN=                    # access token permanente (System User) — usado pra responder mensagens
META_PHONE_NUMBER_ID=             # ID do número remetente (não é o telefone; pega no dashboard)
META_GRAPH_VERSION=v23.0          # versão da Graph API

# Anthropic — cérebro do agente
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI — só transcrição de áudio (o Claude não recebe áudio)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Supabase — o agente entra com o PRÓPRIO usuário (perfil "assistente"), NÃO service_role.
# O login passa pela Edge Function `agente-sessao` (o login por senha exige CAPTCHA).
SUPABASE_URL=
SUPABASE_ANON_KEY=
AGENTE_LOGIN_SECRET=              # mesmo valor do secret AGENTE_LOGIN_SECRET da Edge Function (≥ 32 caracteres)

# Ajustes finos (opcionais)
AGENTE_DEBOUNCE_MS=7000           # espera a rajada de mensagens acabar antes de responder
AGENTE_HORAS_NOVA_SESSAO=8        # conversa parada há mais que isso começa histórico novo
AGENTE_MAX_VOLTAS=16              # teto de chamadas de ferramenta por resposta
