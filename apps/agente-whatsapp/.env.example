# UAZAPI — WhatsApp (cliente NÃO oficial: conecta o número como aparelho vinculado)
# Painel: https://uazapi.dev → instância → Server URL e token
UAZAPI_URL=                       # Server URL da instância, sem barra no fim (ex.: https://suaempresa.uazapi.com)
UAZAPI_TOKEN=                     # token da INSTÂNCIA (nunca o admintoken); também prova a origem do webhook

# Anthropic — cérebro do agente
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI — só transcrição de áudio (o Claude não recebe áudio)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Supabase — o agente entra com o PRÓPRIO usuário (perfil "assistente"), NÃO service_role.
# O login passa pela Edge Function `agente-sessao` (o login por senha exige CAPTCHA).
SUPABASE_URL=
SUPABASE_ANON_KEY=
AGENTE_LOGIN_SECRET=              # mesmo valor do secret AGENTE_LOGIN_SECRET da Edge Function (≥ 32 caracteres)

# Ajustes finos (opcionais)
AGENTE_DEBOUNCE_MS=7000           # espera a rajada de mensagens acabar antes de responder
AGENTE_HORAS_NOVA_SESSAO=8        # conversa parada há mais que isso começa histórico novo
AGENTE_MAX_VOLTAS=16              # teto de chamadas de ferramenta por resposta
AGENTE_MAX_ATRASO_MIN=60          # mensagem mais atrasada que isso fica guardada sem resposta automática
AGENTE_MAX_RESPOSTAS_10MIN=8      # passou disso numa conversa (robô do outro lado?), vai para a equipe
